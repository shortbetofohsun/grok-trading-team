{
  "manifest_version": 3,
  "name": "Grok Edge-Render 실매매 브리지",
  "version": "2.0.0",
  "description": "omni.variational.io 브라우저 세션과 Render 24시간 스탑헌팅 서버를 직접 연결해 부계정 실전 주문을 실행합니다.",
  "permissions": [
    "cookies",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://omni.variational.io/*",
    "https://*.variational.io/*",
    "https://grok-trading-team.onrender.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://omni.variational.io/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grok Edge-Render 브리지"
  }
}
